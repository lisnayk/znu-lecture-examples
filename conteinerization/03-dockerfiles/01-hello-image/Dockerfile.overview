FROM node:22-alpine
LABEL org.opencontainers.image.title="hello-image"
WORKDIR /app
COPY server.js ./

ENV PORT=3000 \
    APP_TITLE="Образ зібрано з Dockerfile"
EXPOSE 3000
USER node

HEALTHCHECK --interval=10s --timeout=3s --start-period=2s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/healthz || exit 1

CMD ["node", "server.js"]
