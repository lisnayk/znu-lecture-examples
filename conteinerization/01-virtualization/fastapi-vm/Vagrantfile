Vagrant.configure("2") do |config|
  config.vm.box = "generic/ubuntu2204"
  config.vm.box_version = "4.3.12"
  config.vm.hostname = "vc-lab1"
  config.vm.network "forwarded_port",
    guest: 8000, host: 8080, host_ip: "127.0.0.1"
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.provider "virtualbox" do |vb|
    vb.memory = 2048
    vb.cpus = 2
  end
  # Код береться з відкритого репозиторію, як і в EC2: гостьова система
  # отримує саме те, що опубліковано, а не вміст каталогу на хості.
  # Наслідок: локальні правки потрапляють у VM лише після push.
  config.vm.provision "shell", inline: <<-SHELL
    set -e
    apt-get update
    apt-get install -y git python3-venv
    su - vagrant -c '
      set -e
      rm -rf ~/znu-lecture-examples
      git clone --depth 1 https://github.com/lisnayk/znu-lecture-examples.git ~/znu-lecture-examples
      ln -sfn ~/znu-lecture-examples/conteinerization/01-virtualization/fastapi-vm ~/lab1
      cd ~/lab1
      python3 -m venv .venv
      .venv/bin/python -m pip install --disable-pip-version-check -r requirements.txt
    '
  SHELL
end
