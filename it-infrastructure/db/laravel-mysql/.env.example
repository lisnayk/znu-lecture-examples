APP_NAME="Каталог сервісів"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8767
APP_LOCALE=uk
APP_FALLBACK_LOCALE=uk
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=single
LOG_LEVEL=warning
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
DB_CONNECTION=mysql
DB_AUTH_MODE=local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=infrastructure
DB_USERNAME=
DB_PASSWORD=
AWS_REGION=us-east-1
DB_SECRET_ARN=
DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
DB_TLS_REQUIRED=false
DB_CREATE_IF_MISSING=false
